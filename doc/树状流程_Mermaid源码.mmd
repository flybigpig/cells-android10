%% 三、App → SF → HWC 完整调用链树
flowchart TB
    subgraph APP["App 进程（每应用独立进程）"]
        direction TB
        VR["ViewRootImpl.scheduleTraversals"]
        CH["Choreographer.doFrame  CALLBACK_TRAVERSAL"]
        TR["ThreadedRenderer.draw"]
        RP["RenderProxy.draw  跨线程到 RenderThread"]
        RT["RenderThread: DrawFrame 任务"]
        FB["FrameBuilder 记录绘制指令(GLES/Skia)"]
        SYNC["nSyncAndDrawFrame  同步+绘制"]
        SWAP["eglSwapBuffers / vkQueuePresent"]
        QB["BufferQueue.queueBuffer"]
        VR --> CH --> TR --> RP --> RT --> FB --> SYNC --> SWAP --> QB
    end
    subgraph SF["surfaceflinger 进程（system）"]
        direction TB
        MAIN["main(): createSurfaceFlinger -> init -> addService -> run"]
        INIT["SurfaceFlinger::init 子系统"]
        RE["RenderEngine  GPU合成(Client)"]
        HWC["HWComposer  HAL客户端(AIDL)"]
        SCH["Scheduler + EventThread×2  驱动 vsync"]
        OF["BufferQueue.onFrameAvailable"]
        ACQ["acquireBuffer 取已填 buffer"]
        REF["handleMessageRefresh: handleTransaction"]
        STK["rebuildLayerStacks / computeVisibleRegions"]
        CFG["configureSurfaces  Client+Device 分配"]
        COMP["doComposition -> doDisplayComposition"]
        PRES["present -> HWC presentDisplay"]
        MAIN --> INIT
        INIT --> RE
        INIT --> HWC
        INIT --> SCH
        QB -. "共享内存 buffer handle(fd) 像素不拷贝" .-> OF
        OF --> ACQ --> REF --> STK --> CFG --> COMP --> PRES
    end
    subgraph HWC["hwcomposer HAL 进程（vendor / Treble）"]
        direction TB
        IC["IComposer AIDL  实例 IComposer/default"]
        PD["presentDisplay -> DRM/KMS -> Panel 送显"]
        CB["BnComposerCallback  vsync / hotplug 反向"]
        IC --> PD
    end
    PRES == "AIDL Binder  IComposer::presentDisplay" ==> IC
    CB == "vsync 反向 Binder 调回 SF" ==> SCH
