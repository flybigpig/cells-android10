// Android.bp
cc_binary {
    name: "yourservice",

    srcs: [
        "main_yourservice.cpp",
        "YourService.cpp",
        "IYourService.cpp",
    ],

    shared_libs: [
        "liblog",
        "libutils",
        "libbinder",
        "libcutils",
        // 根据需要添加其他依赖
    ],

    include_dirs: [
        "frameworks/your_module/yourservice",  // 头文件路径
    ],

    init_rc: ["yourservice.rc"],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
